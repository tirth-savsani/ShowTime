            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"payment.captured\",\n  \"payload\": {\n    \"payment\": {\n      \"entity\": {\n        \"id\": \"pay_mock_123\",\n        \"order_id\": \"order_mock_123\",\n        \"status\": \"captured\",\n        \"amount\": 70000\n      }\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/bookings/webhook",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", "webhook"]
